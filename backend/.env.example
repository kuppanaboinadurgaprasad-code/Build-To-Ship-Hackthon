# AgentSphere AI — Autonomous Multi-Agent AI Platform
# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_agentsphere_ai_2026_secure
JWT_EXPIRES_IN=7d

# ─── Supabase PostgreSQL ─────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Google Gemini API ────────────────────────────────────────────────────────
# Recommended model: gemini-3.8-flash
GEMINI_API_KEY=your_google_gemini_api_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app
